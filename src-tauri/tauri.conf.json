{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yandex Music Presence",
  "version": "0.5.0",
  "identifier": "com.urodstvo.discord-music-activity",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Яндекс Музыка → Discord",
        "width": 760,
        "height": 560,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: https://avatars.yandex.net https://avatars.mds.yandex.net https://*.mzstatic.com https://*.dzcdn.net",
        "connect-src": "'self' ipc: http://ipc.localhost https://github.com https://release-assets.githubusercontent.com https://objects.githubusercontent.com",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://github.com/urodstvo/discord-music-activity/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNDMxRjQxQzIyMTZFNjQKUldSa2JpSENRUjlEVDBMQkRWeFA3ZWVUM2d2ODUzWHVTZnpHVVN1Z0podkgzWUFwcmVoaUxqR3YK"
    }
  }
}
